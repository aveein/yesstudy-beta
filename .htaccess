Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Specifically redirect /index or /index.php to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.php)? [NC]
RewriteRule ^ / [R=301,L]

# 1. Cleanly redirect browser from /page.php to /page
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Silently map /page back to /page.php on the server
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]